#!/usr/bin/env python3
"""agent-session — interactive AI coding agents in background tmux sessions.

- Starts codex, agy, claude or kimi in a tmux session named
  agent-<agent>-<project> (several per agent, --name to override).
- Optional --task: the agent starts working on it right away.
- Lifecycle watchdog (runs only while sessions exist), per session:
    • idle = no pane output change, no transcript write for this cwd and no
      A2A task in progress on this agent's bridge.
    • claude: stops after the prompt-cache TTL (5 min, or 1 h with a 1 h
      cache) of idleness; others after 30 min (override with --ttl).
    • stops any agent whose 5h or 7d quota reached 0%.

Usage: agent-session start|run <agent> [dir] [--name N] [--ttl 15m|cache|never] [--task "…"]
       agent-session attach|stop <session|agent|all>
       agent-session status
"""

import argparse
import fcntl
import glob
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

PREFIX = "agent-"
HOME = os.path.expanduser("~")
RUN_DIR = f"/run/user/{os.getuid()}/agent-session" if os.path.isdir(f"/run/user/{os.getuid()}") \
    else os.path.join(HOME, ".cache/agent-session")
os.makedirs(RUN_DIR, exist_ok=True)
STATE_ROOT = os.path.join(HOME, ".a2abridge/state")
WATCH_INTERVAL = 15
STATUS_LINES = 4  # bottom pane lines ignored for activity (status lines tick on their own)

COMMANDS = {
    "codex": ["codex", "--no-daemon", "--dangerously-bypass-approvals-and-sandbox"],
    "agy": ["agy", "--dangerously-skip-permissions"],
    "claude": ["claude", "--permission-mode", "auto"],
    "kimi": ["kimi", "--auto"],
}
DEFAULT_TTL = {"codex": 1800, "agy": 1800, "kimi": 1800}  # claude: prompt-cache TTL
QUOTA_KEY = {"claude": "claude", "codex": "codex", "agy": "antigravity", "kimi": "kimi"}


# ---------------------------------------------------------------- helpers

def parse_duration(s):
    s = s.strip().lower()
    if s in ("never", "none", "0"):
        return -1
    mult = {"s": 1, "m": 60, "h": 3600}.get(s[-1])
    return int(float(s[:-1]) * mult) if mult else int(float(s))


def fmt(sec):
    if sec is None or sec < 0:
        return "never"
    h, m, s = sec // 3600, (sec % 3600) // 60, sec % 60
    return f"{h}h {m}m" if h else (f"{m}m {s}s" if m else f"{s}s")


def tmux(*args, check=False):
    return subprocess.run(["tmux", *args], capture_output=True, text=True, check=check)


def sessions():
    out = tmux("list-sessions", "-F", "#{session_name}").stdout
    return [s for s in out.split() if s.startswith(PREFIX)]


def pane(session, fmt_):
    out = tmux("list-panes", "-t", f"={session}:", "-F", fmt_).stdout.strip()
    return out.splitlines()[0] if out else ""


def meta_path(session):
    return os.path.join(RUN_DIR, f"{session}.json")


def load_meta(session):
    try:
        with open(meta_path(session)) as f:
            return json.load(f)
    except Exception:
        return {}


def save_meta(session, meta):
    tmp = meta_path(session) + ".tmp"
    with open(tmp, "w") as f:
        json.dump(meta, f, indent=2)
    os.replace(tmp, meta_path(session))


def drop_meta(session):
    try:
        os.remove(meta_path(session))
    except FileNotFoundError:
        pass


def agent_of(session, meta=None):
    meta = meta or load_meta(session)
    if meta.get("agent"):
        return meta["agent"]
    rest = session[len(PREFIX):]
    return next((a for a in COMMANDS if rest == a or rest.startswith(a + "-")), None)


def slug(s):
    return re.sub(r"[^A-Za-z0-9_-]", "-", s).strip("-") or "root"


def resolve(target):
    """Session name for a session name, agent name or unique prefix."""
    all_ = sessions()
    if target in all_:
        return target
    matches = [s for s in all_ if agent_of(s) == target] or [s for s in all_ if s.startswith(PREFIX + target)]
    if len(matches) == 1:
        return matches[0]
    if not matches:
        sys.exit(f"No running session matches '{target}'.")
    sys.exit(f"'{target}' is ambiguous: {', '.join(matches)}")


# ---------------------------------------------------------------- quota

_quota_mod = None


def quota_stats(agent):
    global _quota_mod
    try:
        if _quota_mod is None:
            path = shutil.which("agent-quota") or os.path.join(HOME, ".local/bin/agent-quota")
            loader = importlib.machinery.SourceFileLoader("agent_quota", path)
            spec = importlib.util.spec_from_loader("agent_quota", loader)
            _quota_mod = importlib.util.module_from_spec(spec)
            loader.exec_module(_quota_mod)
        return _quota_mod.collect_all_stats(QUOTA_KEY[agent]).get(QUOTA_KEY[agent])
    except Exception:
        return None


def quota_exhausted(agent, stats=None):
    q = ((stats if stats is not None else quota_stats(agent)) or {}).get("quota") or {}
    checks = [
        ("five_hour_remaining_pct", "five_hour_used_pct", "five_hour_resets_in", "5h"),
        ("seven_day_remaining_pct", "seven_day_used_pct", "seven_day_resets_in", "7d"),
        ("weekly_remaining_pct", None, "seven_day_resets_in", "weekly"),
    ]
    for rem_k, used_k, reset_k, label in checks:
        rem, used = q.get(rem_k), q.get(used_k) if used_k else None
        if (rem is not None and rem <= 0) or (used is not None and used >= 100):
            return f"{label} quota exhausted (resets in {q.get(reset_k) or 'unknown'})"
    return None


def claude_cache_ttl():
    try:
        with open(os.path.join(HOME, ".claude/quota_cache.json")) as f:
            ttl = str(json.load(f).get("prompt_cache", {}).get("ttl") or "")
        return 3600 if ttl.startswith("1h") or ttl == "3600" else 300
    except Exception:
        return 300


# ---------------------------------------------------------------- activity

def descendants(pid):
    out = subprocess.run(["ps", "-e", "-o", "pid=,ppid="], capture_output=True, text=True).stdout
    children = {}
    for line in out.splitlines():
        p, pp = line.split()
        children.setdefault(int(pp), []).append(int(p))
    seen, stack = [], [pid]
    while stack:
        p = stack.pop()
        seen.append(p)
        stack.extend(children.get(p, []))
    return seen


def newest_mtime(paths):
    best = 0.0
    for p in paths:
        try:
            best = max(best, os.path.getmtime(p))
        except OSError:
            pass
    return best


def transcript_activity(agent, cwd, since):
    """Last write to this agent's transcript for this working directory."""
    if agent == "claude":
        return newest_mtime(glob.glob(os.path.join(HOME, ".claude/projects", re.sub(r"[^A-Za-z0-9]", "-", cwd), "*.jsonl")))
    if agent == "codex":
        best = 0.0
        for f in glob.glob(os.path.join(HOME, ".codex/sessions/*/*/*/*.jsonl")):
            try:
                m = os.path.getmtime(f)
                if m < since or m <= best:
                    continue
                with open(f) as fh:
                    first = json.loads(fh.readline() or "{}")
                if first.get("payload", {}).get("cwd") == cwd:
                    best = m
            except Exception:
                pass
        return best
    if agent == "kimi":
        files = glob.glob(os.path.join(HOME, ".kimi-code/sessions", f"wd_{os.path.basename(cwd)}_*", "**"), recursive=True)
        return newest_mtime(files)
    if agent == "agy":  # transcripts carry no cwd; global, errs towards keeping the session
        return newest_mtime(glob.glob(os.path.join(HOME, ".gemini/antigravity-cli/brain/*/.system_generated/logs/transcript.jsonl")))
    return 0.0


def pane_activity(session, meta):
    out = tmux("capture-pane", "-p", "-t", f"={session}:").stdout.rstrip("\n").splitlines()
    body = "\n".join(out[:-STATUS_LINES] if len(out) > STATUS_LINES else out)
    digest = hashlib.sha1(body.encode()).hexdigest()
    if digest != meta.get("pane_hash"):
        meta["pane_hash"], meta["pane_changed_at"] = digest, time.time()
    return meta.get("pane_changed_at", 0.0)


def bridge_urls(pane_pid):
    """A2A URLs of the bridges inside this session (state dirs are keyed by agent pid)."""
    urls = []
    for pid in descendants(pane_pid):
        log = os.path.join(STATE_ROOT, str(pid), "bridge.log")
        try:
            with open(log) as f:
                lines = f.readlines()[-200:]
        except OSError:
            continue
        for line in reversed(lines):
            if '"a2a server listening"' in line:
                try:
                    urls.append(json.loads(line)["url"])
                except Exception:
                    pass
                break
    return urls


def a2a_busy(pane_pid):
    for url in bridge_urls(pane_pid):
        try:
            req = urllib.request.Request(
                url + "/", method="POST",
                data=json.dumps({"jsonrpc": "2.0", "id": 1, "method": "ListTasks", "params": {}}).encode(),
                headers={"Content-Type": "application/json", "A2A-Version": "1.0"},
            )
            tasks = json.load(urllib.request.urlopen(req, timeout=1)).get("result", {}).get("tasks", [])
            if any(t.get("status", {}).get("state") in ("TASK_STATE_WORKING", "TASK_STATE_SUBMITTED") for t in tasks):
                return True
        except Exception:
            pass
    return False


def last_activity(session, meta):
    agent, cwd = agent_of(session, meta), meta.get("cwd") or pane(session, "#{pane_current_path}")
    since = meta.get("started_at", 0)
    return max(since, pane_activity(session, meta), transcript_activity(agent, cwd, since))


# ---------------------------------------------------------------- watchdog

def kill(session, reason):
    print(f"[watchdog] stopping '{session}': {reason}", flush=True)
    tmux("kill-session", "-t", f"={session}")
    drop_meta(session)


def watchdog_tick():
    now, quota_cache = time.time(), {}
    live = sessions()
    for stale in glob.glob(os.path.join(RUN_DIR, PREFIX + "*.json")):
        if os.path.basename(stale)[:-5] not in live:
            os.remove(stale)
    for s in live:
        meta = load_meta(s)
        agent = agent_of(s, meta)
        if agent is None:
            continue
        if agent not in quota_cache:
            quota_cache[agent] = quota_exhausted(agent)
        if quota_cache[agent] and not meta.get("force"):
            kill(s, quota_cache[agent])
            continue
        ttl = meta.get("ttl_sec")
        if ttl is None:
            ttl = claude_cache_ttl() if agent == "claude" else DEFAULT_TTL[agent]
        act = last_activity(s, meta)
        try:
            pane_pid = int(pane(s, "#{pane_pid}") or 0)
        except ValueError:
            pane_pid = 0
        if pane_pid and a2a_busy(pane_pid):
            meta["a2a_busy_at"] = now
        act = max(act, meta.get("a2a_busy_at", 0))
        meta["last_activity"] = act
        if meta:
            save_meta(s, meta)
        if ttl != -1 and now - act >= ttl:
            kill(s, f"idle for {fmt(int(now - act))} (ttl {fmt(ttl)})")
    return len(sessions())


WATCHDOG_LOCK = os.path.join(RUN_DIR, "watchdog.lock")


def ensure_watchdog():
    """Spawn a watchdog; it exits on its own if another one keeps running (see watchdog_loop)."""
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "_watchdog"],
                     stdin=subprocess.DEVNULL, stdout=open(os.path.join(RUN_DIR, "watchdog.log"), "a"),
                     stderr=subprocess.STDOUT, start_new_session=True)


def watchdog_loop():
    # The lock (held for the process lifetime) makes the watchdog a singleton:
    # parallel `start`s may spawn several, all but one exit here.
    lock = open(WATCHDOG_LOCK, "a")
    # Wait one interval: if the running watchdog is just exiting (it saw zero
    # sessions before ours started), we take over instead of leaving none.
    deadline = time.time() + WATCH_INTERVAL + 5
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except OSError:
            if time.time() >= deadline:
                return
            time.sleep(1)
    pid_file = os.path.join(RUN_DIR, "watchdog.pid")
    with open(pid_file, "w") as f:
        f.write(str(os.getpid()))
    try:
        while True:
            try:
                if watchdog_tick() == 0:
                    break
            except Exception as e:
                print(f"[watchdog] error: {e}", flush=True)
            time.sleep(WATCH_INTERVAL)
    finally:
        try:
            os.remove(pid_file)
        except FileNotFoundError:
            pass


# ---------------------------------------------------------------- commands

def cmd_start(a):
    agent = a.agent
    target = os.path.abspath(os.path.expanduser(a.dir or os.getcwd()))
    session = PREFIX + slug(a.name or f"{agent}-{os.path.basename(target)}")
    if tmux("has-session", "-t", f"={session}").returncode == 0:
        print(f"Session '{session}' is already running (attach: agent-session attach {session}).")
        return session
    if not shutil.which(COMMANDS[agent][0]):
        sys.exit(f"✗ {agent} is not installed.")
    if not a.force:
        reason = quota_exhausted(agent)
        if reason:
            sys.exit(f"✗ Cannot start {agent}: {reason}. Use --force to start anyway.")

    cmd = list(COMMANDS[agent])
    send_task = None
    if a.task:
        if agent in ("claude", "codex"):
            cmd.append(a.task)
        elif agent == "agy":
            cmd += ["--prompt-interactive", a.task]
        else:
            send_task = a.task  # kimi has no initial-prompt flag for interactive mode

    ttl = None
    if a.ttl:
        ttl = None if a.ttl.lower() in ("cache", "cache-expire") else parse_duration(a.ttl)

    tmux("new-session", "-d", "-s", session, "-c", target, *cmd, check=True)
    time.sleep(2)
    if tmux("has-session", "-t", f"={session}").returncode != 0:
        sys.exit(f"✗ {agent} exited right after start.")
    if send_task:
        time.sleep(3)
        tmux("send-keys", "-t", f"={session}:", "-l", send_task)
        tmux("send-keys", "-t", f"={session}:", "Enter")

    save_meta(session, {"agent": agent, "session": session, "cwd": target, "started_at": time.time(), "ttl_sec": ttl,
                        "force": bool(a.force)})
    ensure_watchdog()
    eff = ttl if ttl is not None else (claude_cache_ttl() if agent == "claude" else DEFAULT_TTL[agent])
    print(f"✓ {agent} running in tmux session '{session}' at {target}")
    print(f"  lifecycle: stop after {fmt(eff)} idle · stop on 0% quota")
    print(f"  attach: agent-session attach {session}   stop: agent-session stop {session}")
    return session


def cmd_attach(a):
    os.execvp("tmux", ["tmux", "attach-session", "-t", "=" + resolve(a.target)])


def cmd_stop(a):
    targets = sessions() if a.target == "all" else [resolve(a.target)]
    for s in targets:
        tmux("kill-session", "-t", f"={s}")
        drop_meta(s)
        print(f"✓ stopped {s}")
    if not targets:
        print("No agent sessions running.")


def cmd_status(_a):
    now = time.time()
    live = sessions()
    print("=== Agent sessions ===")
    if not live:
        print("  (none)")
    for s in live:
        meta = load_meta(s)
        agent = agent_of(s, meta) or "?"
        ttl = meta.get("ttl_sec")
        if ttl is None and agent in COMMANDS:
            ttl = claude_cache_ttl() if agent == "claude" else DEFAULT_TTL[agent]
        idle = int(now - meta.get("last_activity", meta.get("started_at", now)))
        stats = quota_stats(agent) if agent in COMMANDS else None
        q = (stats or {}).get("quota") or {}
        quota = []
        for label, key in (("5h", "five_hour_remaining_pct"), ("7d", "seven_day_remaining_pct")):
            v = q.get(key, q.get("weekly_remaining_pct") if label == "7d" else None)
            if v is not None:
                color = "\033[31m" if v <= 10 else "\033[32m"
                quota.append(f"{label} {color}{v}%\033[0m")
        life = "ttl never" if ttl == -1 else f"idle {fmt(idle)} · stop in {fmt(max(0, ttl - idle))}"
        print(f"  \033[1m{s}\033[0m ({agent}) cwd {meta.get('cwd') or pane(s, '#{pane_current_path}')}")
        print(f"      {life}{' · quota ' + ', '.join(quota) if quota else ''}")

    print("\n=== A2A peers ===")
    try:
        peers = json.load(urllib.request.urlopen("http://127.0.0.1:7777/agents", timeout=1.5))
    except Exception as e:
        print(f"  (directory unreachable: {e})")
        return
    if not peers:
        print("  (none)")
    for p in peers:
        url = p.get("url", "")
        try:
            card = json.load(urllib.request.urlopen(url + "/.well-known/agent-card.json", timeout=0.8))
            skills = ",".join(s.get("name", s.get("id", "")) for s in card.get("skills", []))
            print(f"  • {card.get('name', '?'):<28} {url}  {skills}")
        except Exception:
            print(f"  • (unreachable) {url}")


def main():
    if sys.argv[1:2] == ["_watchdog"] or sys.argv[1:2] == ["_watchdog_loop"]:
        return watchdog_loop()
    ap = argparse.ArgumentParser(prog="agent-session", description="AI agents in background tmux sessions")
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("start", "run"):
        p = sub.add_parser(name, help="start (and for run: attach) an agent session")
        p.add_argument("agent", choices=list(COMMANDS))
        p.add_argument("dir", nargs="?")
        p.add_argument("--name", help="session name (default <agent>-<project>)")
        p.add_argument("--ttl", help="idle timeout: 15m, 1h, cache, never")
        p.add_argument("--task", help="initial prompt")
        p.add_argument("--force", action="store_true", help="start even with 0%% quota")
    sub.add_parser("attach").add_argument("target")
    sub.add_parser("stop").add_argument("target", help="session, agent or 'all'")
    sub.add_parser("status")
    a = ap.parse_args()
    if a.cmd == "start":
        cmd_start(a)
    elif a.cmd == "run":
        a.target = cmd_start(a)
        cmd_attach(a)
    elif a.cmd == "attach":
        cmd_attach(a)
    elif a.cmd == "stop":
        cmd_stop(a)
    elif a.cmd == "status":
        cmd_status(a)


if __name__ == "__main__":
    main()
