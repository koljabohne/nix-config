# Deduplicate path and fpath arrays (speeds up command and completion lookups)
typeset -U path fpath cdpath

alias vi=nvim

# Nix-darwin management aliases
alias nix-reb='sudo darwin-rebuild switch --impure --flake ~/nix#MacBook-Pro'
alias nix-open='code ~/nix'

# Lazy load fnm (only when needed)
eval "$(fnm env --use-on-cd --shell zsh)"


############## OH MY ZSH ####################

# Path to your omz installation, nix-darwin
export ZSH="$(readlink -f /etc/static/zsh/omz-script)"

ZSH_THEME="robbyrussell"
plugins=(
   git
   docker
   macos
)
source $ZSH/oh-my-zsh.sh

#############################################

zstyle ':completion:*' menu select
bindkey '^I' expand-or-complete-prefix
zstyle ':completion:*' completer _complete _match
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'
zstyle ':omz:lib:theme-and-appearance' gnu-ls yes
zstyle ':completion:*' accept-exact 'yes'

alias ls='ls --color'

zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"



######## zinit #################

ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# Download Zinit, if it's not there yet
if [ ! -d "$ZINIT_HOME" ]; then
   mkdir -p "$(dirname $ZINIT_HOME)"
   git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
fi

# Source/Load zinit
source "${ZINIT_HOME}/zinit.zsh"

# Load autosuggestions immediately (synchronously)
zinit light zsh-users/zsh-autosuggestions

### plugins (with turbo mode for speed)
zinit wait lucid for \
    zsh-users/zsh-syntax-highlighting \
    zsh-users/zsh-completions \
    Aloxaf/fzf-tab

zinit cdreplay -q



bindkey -e
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[w' kill-region


##### history ##############

HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
unsetopt SHARE_HISTORY  # OMZ sets this; explicitly disable to prevent cross-session bleed
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

#######################

# flutter
export PATH="$PATH:$HOME/flutter/bin"
export PATH="$HOME/.local/bin:$PATH"

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh" || true


# Source static conda definitions (takes ~8ms instead of ~390ms)
if [ -f "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh" ]; then
    . "/opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh"
else
    export PATH="/opt/homebrew/Caskroom/miniconda/base/bin:$PATH"
fi

# Statically activate the 'base' env on startup (takes ~1ms, saving another ~390ms!)
if [ -z "${CONDA_SHLVL+x}" ] || [ "$CONDA_SHLVL" -eq 0 ]; then
    export CONDA_SHLVL=1
    export CONDA_DEFAULT_ENV='base'
    export CONDA_PREFIX='/opt/homebrew/Caskroom/miniconda/base'
    export CONDA_PROMPT_MODIFIER='(base) '
    export PATH="/opt/homebrew/Caskroom/miniconda/base/bin:$PATH"
    
    # Prepend (base) to prompt and backup PS1 so conda deactivate/activate work correctly
    if [ -z "${CONDA_PS1_BACKUP+x}" ]; then
        export CONDA_PS1_BACKUP="${PS1:-}"
    fi
    PS1="(base) ${PS1:-}"

    # Source activation scripts for packages (like gfortran, clang, etc.)
    for f in /opt/homebrew/Caskroom/miniconda/base/etc/conda/activate.d/*.sh; do
        if [ -f "$f" ]; then
            . "$f"
        fi
    done
fi
